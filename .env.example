# Configurações do Banco de Dados PostgreSQL
POSTGRES_DB=clinica_db
POSTGRES_USER=clinica_user
POSTGRES_PASSWORD=clinica_pass_dev_change_me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Configurações do Back-end Django
DJANGO_SECRET_KEY=django-insecure-mvp-dev-key-change-in-production-123456789
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Configurações de CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Configurações da API de IA (Google Gemini - Desafios 8 e 9)
GEMINI_API_KEY=your_gemini_api_key_here

# Configurações do Front-end
VITE_API_BASE_URL=http://localhost:8000/api
